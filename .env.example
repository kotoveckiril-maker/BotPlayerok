# ─────────────────────────────────────────────────────────────
#  BotPlayerok — пример конфигурации
#  Скопируйте в .env и заполните:  cp .env.example .env
# ─────────────────────────────────────────────────────────────

# ── База данных PostgreSQL ───────────────────────────────────
# При запуске через docker-compose эту переменную задавать не нужно —
# она подставляется автоматически из POSTGRES_*.
DATABASE_URL=postgresql://botplayerok:change_me_please@127.0.0.1:5432/botplayerok

# ── Пароль админки ───────────────────────────────────────────
# Если не задать — при первом запуске пароль сгенерируется и один раз
# будет напечатан в логах. Пароль можно сменить в настройках.
ADMIN_PASSWORD=change-me-please

# ── Секрет шифрования (важно!) ───────────────────────────────
# 32+ случайных символа. Используется для AES-256-GCM шифрования токенов
# и подписи сессий. Если не задать — ключ создаётся в файле .data/secret.key.
# ОБЯЗАТЕЛЬНО сохраните его в надёжном месте: без него секреты не восстановить!
# Сгенерировать: openssl rand -base64 48
# SETTINGS_SECRET=

# ── ИИ-автоответчик (OpenAI-совместимый API) ─────────────────
# Можно задать ключ здесь или прямо в админке (тогда он зашифруется в БД).
# OPENAI_API_KEY=sk-...
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# ── Telegram-уведомления ─────────────────────────────────────
# Удобнее настроить в админке. Переменные — альтернатива для Docker.
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=123456789

# ── Прочее ───────────────────────────────────────────────────
TZ=Europe/Moscow
# COOKIE_SECURE=1      # ставьте 1, если сайт доступен только по HTTPS
# DATA_DIR=/app/data   # папка для ключа шифрования (в Docker уже задана)
# APP_PORT=3000        # порт хоста для docker-compose
